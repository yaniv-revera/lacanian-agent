# Requires Node 22.5+ (uses the built-in node:sqlite module).

# ---- provider ----
# "anthropic", "openai", or "mock" (no key needed — exercises the frame only)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- server ----
PORT=3000
DB_PATH=./data/app.db
SESSION_SECRET=change-me-to-a-long-random-string

# ---- frame ----
# Hours the door stays shut after the analyst ends a session.
LOCKOUT_HOURS=24
# Turn floor before ending is permitted at all.
MIN_TURNS_BEFORE_END=15
# Soft ceiling; the server ends the session itself past this.
MAX_TURNS=40
# Gate-touched sessions are NEVER locked — hard-coded, not configurable.
# Anchored sessions are also spared by default. Set to false to lock them too.
LOCKOUT_SKIP_ANCHORED=true

# ---- crisis resources ----
# Verified, locale-specific. Leave blank to inject the literal string UNAVAILABLE.
# The model is forbidden from inventing numbers, so blank is safe — just less useful.
# Example:
# CRISIS_RESOURCES=Israel: ERAN 1201 | Emergency 101. UK: Samaritans 116 123 | Emergency 999. US: 988 | Emergency 911.
CRISIS_RESOURCES=

# ---- email ----
# "console" logs login codes to stderr (fine for local use).
# "smtp" uses the SMTP_* vars below.
MAILER=console
SMTP_URL=
MAIL_FROM=
